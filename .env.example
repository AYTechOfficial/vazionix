# =============================================================================
# VAZIONIX — ENVIRONMENT
# =============================================================================
# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# values. Everything marked SERVER ONLY is a secret. Everything prefixed
# NEXT_PUBLIC_ is compiled into the browser bundle — putting a secret there
# publishes it.
#
# Every variable below is read by real code. Grep for it before deleting one.
# Variables the platform injects (NODE_ENV, K_SERVICE, GCLOUD_PROJECT) are
# documented at the bottom and must NOT be set by hand.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. FIREBASE WEB CONFIG — client, safe to expose
# -----------------------------------------------------------------------------
# Read by src/lib/firebase/client.ts. These are IDENTIFIERS, not credentials.
# They ship in the JavaScript bundle by design and Google's own documentation
# says so. Access control comes from firestore.rules and App Check, never from
# hiding this config; anyone telling you to proxy them is protecting the wrong
# thing.
#
# Where: Firebase console → Project settings → General → Your apps → SDK setup
# and configuration.
#
# WITHOUT THESE: the client SDK cannot initialise, so sign-in fails and the
# realtime balance listener never attaches. Server-rendered pages still work,
# which makes this a confusing failure — the site looks fine until you try to
# log in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional. Only needed if you enable Google Analytics for Firebase. Absent is
# fine; analytics simply never initialises.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# NEXT_PUBLIC_FIREBASE_PROJECT_ID is also read by src/lib/firebase/admin.ts to
# name the Admin SDK app, so it is required on the server too. It is the one
# variable in this file that both halves depend on.

# -----------------------------------------------------------------------------
# 2. FIREBASE ADMIN — SERVER ONLY. This one IS a secret.
# -----------------------------------------------------------------------------
# The full service-account JSON, base64-encoded:
#
#   base64 -w0 service-account.json                 # Linux / Git Bash
#   base64 -i service-account.json | tr -d '\n'     # macOS
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#                                                   # PowerShell
#
# WHY BASE64 AND NOT THE RAW JSON: the service account's `private_key` is a PEM
# block containing literal newline characters. Vercel, Fly, Railway, Docker
# Compose, systemd and GitHub Actions each mangle newlines in an env var
# differently — some strip them, some escape them, some truncate the value at
# the first one. Base64 is a single line of [A-Za-z0-9+/=] that survives all of
# them. src/lib/firebase/admin.ts decodes it once, in one place, instead of
# scattering `.replace(/\\n/g, '\n')` through the codebase.
#
# Where: Firebase console → Project settings → Service accounts → Generate new
# private key. Treat the downloaded file like a root password: it can read and
# write every document in the project and mint session cookies for any user.
#
# WITHOUT IT: every Route Handler fails, `isServerFirebaseReady()` returns
# false, and the app degrades to empty read models — the faucet renders but
# nothing can be claimed, and /admin redirects to the staff login forever.
FIREBASE_SERVICE_ACCOUNT_KEY=

# THE ALTERNATIVE, AND THE BETTER ONE IN PRODUCTION: Application Default
# Credentials. On Cloud Run, GCE, App Engine and Cloud Functions the runtime
# service account is picked up automatically — leave FIREBASE_SERVICE_ACCOUNT_KEY
# blank and there is no key to leak, rotate or check into git. Locally you can
# point at a key file instead of base64-encoding it:
#
#   export GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
#
# src/server/db.ts#isServerFirebaseReady() treats either as "credentials
# present", along with FIRESTORE_EMULATOR_HOST, GCLOUD_PROJECT and K_SERVICE.
# GOOGLE_APPLICATION_CREDENTIALS=

# Set by `firebase emulators:start`, not by you. Present here so you know that
# exporting it makes the app talk to the local Firestore emulator instead of
# production — which is exactly what you want before testing a seed script.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# -----------------------------------------------------------------------------
# 3. SITE IDENTITY — client, safe to expose
# -----------------------------------------------------------------------------
# Read by src/lib/brand.ts, which is the single source of truth for the product
# name, domain, addresses and handles. Nothing else hardcodes them.
#
# NEXT_PUBLIC_SITE_URL is load-bearing. It builds every absolute URL in the
# product: referral links (`/?r=code`), Open Graph tags, and the offerwall
# postback URL you paste into a provider's dashboard. No trailing slash — one is
# stripped anyway.
#
# INCLUDE THE SCHEME. Vercel's dashboard displays your domain as
# `vazionix.vercel.app`, so that is what people paste, and a schemeless value used
# to fail the build with `ERR_INVALID_URL` on `/_not-found` — an error that never
# mentioned this variable. `src/lib/brand.ts` now prepends `https://` when the
# scheme is missing, but set it properly anyway; the normalisation is a safety net,
# not a licence.
#
# WITHOUT IT: defaults to http://localhost:3000, so every referral link you hand a
# user points at their own machine. This is the single most common production
# misconfiguration in this codebase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 3b. SUPABASE — BACKEND (Phase A migration; replaces the Firebase data layer)
# -----------------------------------------------------------------------------
# Read by src/server/data (the Supabase adapter). The publishable key is safe in
# a NEXT_PUBLIC_ var; the service_role key is a server secret and must NEVER carry
# a NEXT_PUBLIC_ prefix or it ships to the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SERVER ONLY
SUPABASE_SERVICE_ROLE_KEY=service_role <jwt>

# Shown in the footer, on the support page, and in the "email us" fallback when
# ticketing is unavailable. Defaults to support@vazionix.com / noreply@vazionix.com
# if unset, which will be wrong for your domain.
NEXT_PUBLIC_SUPPORT_EMAIL=support@vazionix.com
NEXT_PUBLIC_NOREPLY_EMAIL=noreply@vazionix.com

# Social links in the footer and the community page. An empty value hides the
# icon rather than rendering a dead link — leave Discord blank until you have a
# server.
NEXT_PUBLIC_SOCIAL_X=@vazionix
NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/vazionix
NEXT_PUBLIC_SOCIAL_DISCORD=


# -----------------------------------------------------------------------------
# 4. CAPTCHA
# -----------------------------------------------------------------------------
# Read by src/lib/captcha/config.ts (client) and src/server/captcha.ts (server).
# Four providers are supported: adslab | hcaptcha | turnstile | recaptcha, plus
# `none`.
#
# HOW THE PIECES FIT
#   PROVIDER    picks the widget and the default verify endpoint.
#   SITE_KEY    public; renders the widget. No key means no widget, and
#               `captchaEnabled` goes false: gated actions run WITHOUT a captcha.
#   SCRIPT_URL  overrides the loader. Required for AdsLab, which issues a
#               per-account URL rather than a shared one.
#   SECRET_KEY  SERVER ONLY. Without it, and with a provider configured, every
#               gated claim fails closed with a 500 that names this variable —
#               deliberately, because the alternative is a faucet with a
#               decorative captcha.
#   VERIFY_URL  overrides the provider's verification endpoint. Only set it if
#               your provider gave you a different one.

# WORKED EXAMPLE — ADSLAB, the intended provider. Its captcha is a revenue
# product: a solve pays the publisher, so the anti-abuse control and the
# monetisation are the same widget. Take all four values from your AdsLab
# dashboard (Captcha → your zone), then uncomment:
#
#   NEXT_PUBLIC_CAPTCHA_PROVIDER=adslab
#   NEXT_PUBLIC_CAPTCHA_SITE_KEY=al_pub_9f2c1b7e4d
#   NEXT_PUBLIC_CAPTCHA_SCRIPT_URL=https://cdn.adslab.io/captcha/v1/loader.js?z=482913
#   CAPTCHA_SECRET_KEY=al_sec_3e8a6d5c02b14f7a
#   CAPTCHA_VERIFY_URL=https://api.adslab.io/captcha/verify
#
# The site key and script URL above are shaped like real AdsLab values but are
# not real. Replace both.
#
# LOCAL DEVELOPMENT: leave PROVIDER unset (or `none`). Gated actions then run
# with no captcha, which is what you want on localhost and never want in
# production.
NEXT_PUBLIC_CAPTCHA_PROVIDER=none
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
NEXT_PUBLIC_CAPTCHA_SCRIPT_URL=
# SERVER ONLY
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=


# -----------------------------------------------------------------------------
# 5. ADS — client, safe to expose
# -----------------------------------------------------------------------------
# Read by src/lib/ads/config.ts. THESE ARE A BUILD-TIME FALLBACK, NOT THE NORMAL
# PATH. The normal path is Admin → Ads → Inventory, which writes
# /adUnits/{placementId} and takes effect immediately with no deploy. Firestore
# wins over env, env wins over the static table in src/lib/ads/config.ts.
#
# Only six placements are wired to env, and on purpose: Next inlines
# NEXT_PUBLIC_* by literal lookup at build time, so `process.env[computedKey]`
# returns undefined in the browser. Each of these is a global overlay unit you
# might reasonably want frozen into a build before the console has data.
#
# TWO ACCEPTED FORMS PER VARIABLE
#   a bare URL           → treated as kind:'script' (kind:'url' for the
#                          shortlink direct link)
#   a JSON AdUnitConfig  → used as-is, so you can set network, cap and geo
#
# Bare URL:
#   NEXT_PUBLIC_AD_GLOBAL_SOCIALBAR=//pl26481932.profitablecpmgate.com/aa/bb/cc/aabbcc.js
#
# JSON (single line, no trailing comma — a malformed value is ignored and the
# slot renders its placeholder, which is visible and therefore self-reporting):
#   NEXT_PUBLIC_AD_GLOBAL_POPUNDER={"kind":"script","src":"//pl26481933.profitablecpmgate.com/dd/ee/ff.js","network":"Adsterra","capPerSession":1}
#
# WITHOUT THESE: nothing breaks. Unfilled slots render a dimension-labelled
# placeholder in development and blank in production.
NEXT_PUBLIC_AD_GLOBAL_SOCIALBAR=
NEXT_PUBLIC_AD_GLOBAL_POPUNDER=
NEXT_PUBLIC_AD_GLOBAL_INPAGEPUSH=
NEXT_PUBLIC_AD_GLOBAL_INTERSTITIAL=
NEXT_PUBLIC_AD_GLOBAL_ANCHOR=
# The monetised hop the shortlink engine sends users through. A URL, not a box.
NEXT_PUBLIC_AD_SHORTLINK_DIRECTLINK=

# -----------------------------------------------------------------------------
# 6. PAYOUT RAILS — SERVER ONLY. These ARE secrets.
# -----------------------------------------------------------------------------
# Read by src/server/payouts.ts. A rail is enabled by the presence of its key and
# by nothing else: an unconfigured rail REFUSES the send and leaves the
# withdrawal Pending with the tokens still locked, rather than pretending to have
# paid. Admin → Rail health shows which rails are configured, derived from these
# two variables.
#
# FaucetPay: dashboard → API → your API key. Scoped to send; the key can move
# your merchant balance, so treat it as a bearer credential for real money.
FAUCETPAY_API_KEY=

# CWallet: developer console → API keys. The endpoint is overridable because
# CWallet has changed its base path before and a redeploy to chase it is
# avoidable.
CWALLET_API_KEY=
CWALLET_API_URL=https://openapi.cwallet.com/v1/transfer

# There is deliberately no key for the Direct rail. Direct on-chain payouts are
# batched and broadcast from custody tooling; a signing key does not belong in a
# web process, and approving a Direct payout in the console only marks it
# Processing and records who approved it.


# -----------------------------------------------------------------------------
# 6b. PRICING — SERVER ONLY (Cloud Functions), optional
# -----------------------------------------------------------------------------
# Read by the scheduled `refreshRates` job in functions/src/index.ts, which pulls
# spot prices into /config/rates. Sent as the `x-cg-demo-api-key` header.
#
# WITHOUT IT: the job still runs against CoinGecko's public endpoint, which is
# rate-limited per IP. On a warm Cloud Functions instance that is usually enough;
# if the job starts logging 429s, get a free demo key. If pricing stops updating
# entirely, /config/rates keeps its last written values and the withdraw page
# quotes from those rather than failing — stale, but never wrong-by-zero.
#
# Set it as a Functions secret rather than in .env.local, since only the
# functions runtime reads it:
#
#   firebase functions:secrets:set COINGECKO_API_KEY
COINGECKO_API_KEY=


# -----------------------------------------------------------------------------
# 7. STAFF AND OPERATIONS — SERVER ONLY
# -----------------------------------------------------------------------------
# Read by src/lib/admin/guard.ts. Staff sessions require an `mfa: true` custom
# claim; a staff token without it is treated as not-staff, which is the correct
# default for a console that can move money.
#
# Set to `false` ONLY while enrolling your very first admin account, then remove
# the line. Leaving it false permanently means a stolen staff password is a
# complete compromise.
# STAFF_REQUIRE_MFA=false

# Read by scripts/bootstrap-admin.mjs AND by the `claimFirstStaffRole` callable in
# functions/src/index.ts. The email address allowed to mint the FIRST super_admin.
# The account must already exist in Firebase Auth: sign up through the site, then
# promote. Set it so `npm run bootstrap:admin` needs no argument.
#
# UNSET IT ONCE THE FIRST ADMIN EXISTS. While it is set, an account holding that
# verified email can grant itself a role, and the callable only refuses once a
# super_admin is already present in /staff.
BOOTSTRAP_ADMIN_EMAIL=


# -----------------------------------------------------------------------------
# 8. SET BY THE PLATFORM — DO NOT PUT THESE IN .env.local
# -----------------------------------------------------------------------------
# NODE_ENV        Next sets it (`development` for `next dev`, `production` for
#                 `next build`). Read in five places, mostly to decide whether
#                 to render ad placeholders and whether cookies are `secure`.
#                 Overriding it by hand breaks the dev server.
# K_SERVICE       Injected by Cloud Run and Cloud Functions. Used only as a
#                 signal that Application Default Credentials will work.
# GCLOUD_PROJECT  Injected by Google runtimes. Same purpose.
#
# That is every `process.env` reference in src/ and functions/. If you add one,
# add it here in the same commit.
